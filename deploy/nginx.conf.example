# Use as the server block for this website; keep existing HTTPS certificate settings.
# Match site.config.json and the ECS_DEPLOY_PATH repository secret.
server {
    listen 80;
    server_name www.nearblade.com;
    root /var/www/nearblade;
    index index.html;

    # Each public route has its own HTML entry with page-specific SEO metadata.
    location / {
        try_files $uri/index.html $uri =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location /images/ {
        try_files $uri =404;
    }

    location /locales/ {
        try_files $uri =404;
    }
}
