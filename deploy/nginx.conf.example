# Include deploy/multilingual-maps.conf in the http {} context first.
# Merge this server content into the existing HTTPS / CDN origin block;
# preserve certificates, forwarding headers and HTTPS/www redirects.
server {
    listen 80;
    server_name www.nearblade.com;
    root /var/www/nearblade;
    index index.html;

    location / {
        # One direct 301 handles old URLs, ?lang=, retired IDs and aliases.
        # $uri maps are evaluated before the internal file lookup.
        if ($nearblade_redirect) {
            return 301 https://www.nearblade.com$nearblade_page_target$nearblade_query_suffix;
        }
        try_files $uri/index.html $uri =404;
    }

    error_page 404 $nearblade_error_page;
    location ~ ^/(?:en|zh-cn|es|fr|de|pt|ru|ar|ja)/404\.html$ {
        internal;
    }
    location = /404.html { internal; }
    location /assets/ { try_files $uri =404; }
    location /images/ { try_files $uri =404; }
    location /locales/ { try_files $uri =404; }
}
