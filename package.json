{
  "name": "nearblade-industrial-blades",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/render-tooling-drawings.mjs && node scripts/render-blade-drawings.mjs && node scripts/check-locales.mjs && vite build && node scripts/build-seo.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build && node --test tests/*.test.mjs",
    "build:ecs": "node scripts/build-ecs.mjs",
    "publish:ecs": "node scripts/publish-ecs.mjs",
    "test:ecs": "node --test tests/ecs-publication.test.mjs",
    "test:site": "node --test tests/site-publication.test.mjs",
    "i18n:extract": "node scripts/extract-locales.mjs",
    "i18n:build": "node scripts/check-locales.mjs",
    "test:i18n": "node --test tests/i18n.test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.2",
    "react-helmet-async": "2.0.5",
    "react-icons": "5.5.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-react": "4.3.3",
    "vite": "5.4.21",
    "typescript": "5.6.2",
    "tailwindcss": "3.4.18",
    "autoprefixer": "10.4.22",
    "postcss": "8.5.6",
    "@tailwindcss/typography": "^0.5.19",
    "tailwindcss-animate": "1.0.7"
  }
}
